{
  "name": "formo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "web": "npm --prefix frontend run dev:prod",
    "mobile": "npm --prefix mobile run start:prod",
    "mobile:local": "npm --prefix mobile run start:local",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f backend frontend"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "^4.5.7",
      "multer": "^2.5.0",
      "body-parser": "^1.20.9",
      "lodash": "^4.18.1",
      "js-yaml": "^4.3.2"
    }
  }
}
