# Server
PORT=3001
NODE_ENV=development

# Database (docker compose up -d bilan ko'tariladi)
DATABASE_URL="postgresql://formo:formo@localhost:5435/formo?schema=public"

# CORS (vergul bilan bir nechta). Productionda majburiy va https://domen ko'rinishida
FRONTEND_URL="http://localhost:5173"

# JWT — productionda kamida 32 belgi (openssl rand -hex 32), aks holda server ishga tushmaydi
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Superadmin (server ishga tushganda yo'q bo'lsa yaratiladi — yagona akkaunt)
# Productionda admin123 kabi dev parollar va 10 belgidan qisqa parol rad etiladi
SUPERADMIN_PHONE="+998901111111"
SUPERADMIN_PASSWORD="admin123"
SUPERADMIN_NAME="Super Admin"

# Swagger (productionda standart o'chiqh)
# SWAGGER_ENABLED=true
# Berilsa /api/docs login/parol so'raydi (productionda Swagger yoqilsa majburiy, kamida 10 belgi)
# SWAGGER_USER=formo
# SWAGGER_PASSWORD=

# Reverse proxy (Railway va h.k.) ortida haqiqiy klient IP'sini olish — rate-limit shunga tayanadi.
# Standart: productionda 1 (bitta proxy), devda o'chiq. Qiymatlar: false | true | hop soni | "loopback, 10.0.0.0/8"
# TRUST_PROXY=1
