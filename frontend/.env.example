# Bo'sh qoldirilsa Vite proxy (/api -> localhost:3001) ishlatiladi.
# Production build'da backend manzili (oxirida /api siz), masalan https://api.formo.uz
VITE_API_URL=
# true — backendsiz test loginlar bilan ishlash (faqat dizayn uchun)
VITE_USE_MOCK_AUTH=false
# Lokal dev: Vite proxy /api ni qayerga yuborsin (standart http://localhost:3001).
# Docker/backendsiz production API bilan ishlash uchun buni yozish shart emas — `npm run dev:prod`.
# DIQQAT: bu PRODUCTION baza — yaratilgan/o'chirilgan hamma narsa haqiqiy.
# VITE_PROXY_TARGET=https://api.formo.uz
