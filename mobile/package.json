{
  "name": "@formo/mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:prod": "node scripts/start-prod.js prod",
    "start:local": "node scripts/start-prod.js local",
    "export:android": "expo export --platform android",
    "build:apk": "eas build --platform android --profile preview",
    "build:aab": "eas build --platform android --profile production",
    "eas-build-pre-install": "npm ci --include=dev --no-audit --no-fund",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "node --test --require ./tests/setup/register.js"
  },
  "dependencies": {
    "@expo-google-fonts/onest": "^0.4.2",
    "@expo-google-fonts/saira-extra-condensed": "^0.4.2",
    "@expo-google-fonts/unbounded": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~58.0.0",
    "expo-build-properties": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-gl": "~58.0.3",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-location": "~58.0.18",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.19",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "typescript": "~6.0.3"
