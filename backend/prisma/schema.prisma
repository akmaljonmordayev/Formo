generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN // yagona akkaunt, .env dan seed qilinadi
  OPERATOR // yagona akkaunt, superadmin yaratadi
  TAILOR // tikuv sexlari, superadmin yaratadi
  USER // mobil ilova foydalanuvchilari, o'zi ro'yxatdan o'tadi
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id           Int     @id @default(autoincrement())
  phone        String  @unique
  passwordHash String
  role         Role    @default(USER)
  fullName     String
  isActive     Boolean @default(true)

  // Mobil foydalanuvchi profili
  gender Gender?
  age    Int?
  height Int? // sm
  weight Int? // kg

  // Tikuv sexi ma'lumotlari
  workshopName  String?
  address       String?
  dailyCapacity Int? // tikuv sexi uchun kunlik bosma sig'imi (dona) — "Sexdagi yuk" foizi shundan hisoblanadi

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  cartItems     CartItem[]
  addresses     Address[]
  favoriteClubs FavoriteClub[]

  ordersAsCustomer Order[] @relation("OrderCustomer")
  ordersAsWorkshop Order[] @relation("OrderWorkshop")

  @@index([role])
}

// Har bir login = bitta sessiya. Logout sessiyani bekor qiladi,
// shuning uchun access token ham darhol ishlamay qoladi.
model Session {
  id               String    @id @default(uuid())
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Katalog: kategoriya (liga) → klub → formalar (ilovadagi "Klub formalari")
// ---------------------------------------------------------------------------

// Katalogdagi filtr chiplari: "LaLiga", "Premier League", "Serie A" ...
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubs Club[]
}

// Klub ligada o'ynaydimi yoki davlat terma jamoasimi — Superadmin panelida ikkisi alohida bo'limda ko'rsatiladi
enum ClubType {
  CLUB
  NATIONAL
}

// Faqat ClubType.NATIONAL uchun — terma jamoalar shu bo'yicha filtrlanadi
enum Continent {
  EUROPE
  ASIA
  AFRICA
  AMERICA
  OCEANIA
}

model Club {
  id         Int       @id @default(autoincrement())
  name       String
  league     String // kategoriya nomi (eski panel shu maydon bilan ishlaydi)
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  season     String
  code       String // nishon ustidagi qisqa harf, masalan "RM"
  markColor  String // nishon foni, hex
  type       ClubType   @default(CLUB)
  continent  Continent? // type=NATIONAL bo'lsa majburiy (DTO darajasida tekshiriladi)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  kits      Kit[]
  orders    Order[]
  favorites FavoriteClub[]

  @@unique([name, season])
  @@index([categoryId])
  @@index([type, continent])
}

// Bitta klubning uy/mehmon/uchinchi formasi
model Kit {
  id        Int    @id @default(autoincrement())
  clubId    Int
  club      Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  label     String // "Uy" | "Mehmon" | "Uchinchi"
  bgColor   String
  textColor String
  sortOrder Int    @default(0)

  // Mahsulot sifatidagi ma'lumotlar: to'plam = futbolka + shortik (+ ism/raqam bosmasi)
  colorsLabel String? // "Oq / oltin"
  description String? // "Dry-fit polyester · DTF bosma"
  shirtPrice  Int      @default(99000) // so'm
  shortsPrice Int      @default(60000)
  printPrice  Int      @default(30000) // ism + raqam bosmasi
  sizes       String[] @default(["S", "M", "L", "XL", "XXL", "3XL"]) // sotuvda bor o'lchamlar
  isActive    Boolean  @default(true)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([clubId])
}

model FavoriteClub {
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId    Int
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, clubId])
}

// ---------------------------------------------------------------------------
// Savat va manzillar (mobil ilova foydalanuvchisi)
// ---------------------------------------------------------------------------

model CartItem {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kitId          Int
  kit            Kit      @relation(fields: [kitId], references: [id], onDelete: Cascade)
  printName      String?
  printNumber    String?
  numberOnShorts Boolean  @default(false)
  withShorts     Boolean  @default(true)
  shirtSize      String
  shortsSize     String?
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String // "Uy", "Ish"
  address   String // "Yunusobod, Amir Temur 108"
  apartment String? // "45-xonadon"
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Buyurtmalar
// ---------------------------------------------------------------------------

enum OrderProductType {
  CLUB_KIT // klub formasi katalogidan
  CUSTOM_DESIGN // dizayn studiyasida o'zi yasagan
}

enum OrderChannel {
  APP
  WEB
}

enum PaymentMethod {
  CLICK
  PAYME
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Bitta maydon ham to'lov, ham ishlab chiqarish bosqichini bildiradi —
// Superadmin panelidagi "Buyurtmalar" va "Ishlab chiqarish" kanban shu ustida ishlaydi.
enum OrderStatus {
  PENDING_PAYMENT // to'lov kutilmoqda
  ACCEPTED // qabul qilindi, bosishni kutmoqda (navbatda)
  PRINTING // bosilmoqda
  QUALITY_CHECK // sifat nazorati
  READY // tayyor, yetkazishga chiqarilmagan
  DELIVERING // yetkazishda
  DELIVERED // yetkazildi
  CANCELLED // bekor qilindi
  RETURNED // qaytarildi
}

model Order {
  id   Int    @id @default(autoincrement())
  code String @unique // "FRM-88424"

  customerId    Int?
  customer      User?  @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String

  workshopId Int?
  workshop   User? @relation("OrderWorkshop", fields: [workshopId], references: [id], onDelete: SetNull)

  clubId   Int?
  club     Club?   @relation(fields: [clubId], references: [id], onDelete: SetNull)
  kitLabel String? // tanlangan forma: "Uy" | "Mehmon" | "Uchinchi"

  productType OrderProductType @default(CLUB_KIT)
  printName   String?
  printNumber String?
  size        String
  quantity    Int              @default(1)

  totalSum    Int // so'm, umumiy summa (yetkazish bilan)
  deliverySum Int @default(0)
  subtotalSum Int @default(0) // mahsulotlar summasi (chegirmagacha)
  discountSum Int @default(0)

  // Yetkazish (mobil ilovadan rasmiylashtirilganda)
  deliveryDate    DateTime? @db.Date
  deliverySlot    String? // "10:00-14:00"
  deliveryAddress String?
  comment         String? // kuryer uchun izoh

  paymentExpiresAt DateTime? // Click/Payme: to'lov kutiladigan muddat (30 daqiqa)
  paidAt           DateTime?

  items OrderItem[]

  channel       OrderChannel  @default(APP)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  status        OrderStatus   @default(PENDING_PAYMENT)

  promocodeId Int?
  promocode   Promocode? @relation(fields: [promocodeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([workshopId])
  @@index([createdAt])
  @@index([customerId])
  @@index([deliveryDate, deliverySlot])
}

// Buyurtma qatorlari — narx va nomlar buyurtma paytidagi holatda saqlanadi
model OrderItem {
  id             Int     @id @default(autoincrement())
  orderId        Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kitId          Int?
  kit            Kit?    @relation(fields: [kitId], references: [id], onDelete: SetNull)
  clubName       String
  kitLabel       String
  printName      String?
  printNumber    String?
  numberOnShorts Boolean @default(false)
  withShorts     Boolean @default(true)
  shirtSize      String
  shortsSize     String?
  quantity       Int
  unitPrice      Int
  totalPrice     Int

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Zaxira: futbolka/shortik, rang va o'lcham bo'yicha qoldiq
// ---------------------------------------------------------------------------

enum InventoryProductType {
  TSHIRT
  SHORTS
}

model InventoryItem {
  id          Int                  @id @default(autoincrement())
  productType InventoryProductType
  color       String
  size        String
  qty         Int                  @default(0)
  updatedAt   DateTime             @updatedAt

  @@unique([productType, color, size])
}

// ---------------------------------------------------------------------------
// Narxlar — mijozga ko'rsatiladigan narx jadvali
// ---------------------------------------------------------------------------

model PricingItem {
  id        Int      @id @default(autoincrement())
  key       String   @unique // masalan "club.tshirt", "studio.custom"
  section   String // "Klub formasi" | "Dizayn studiyasi"
  step      Int
  label     String
  sub       String
  price     Int // so'm
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Promokodlar
// ---------------------------------------------------------------------------

enum PromocodeType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Promocode {
  id        Int           @id @default(autoincrement())
  code      String        @unique
  type      PromocodeType
  value     Int           @default(0) // PERCENT: 0-100, FIXED: so'm, FREE_SHIPPING: ishlatilmaydi
  minSum    Int?
  usageCap  Int?
  usedCount Int           @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  orders Order[]
}

// ---------------------------------------------------------------------------
// Kampaniyalar — push/SMS xabarlar
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
}

enum CampaignChannel {
  PUSH
  SMS
  PUSH_SMS
}

model Campaign {
  id          Int             @id @default(autoincrement())
  name        String
  status      CampaignStatus  @default(DRAFT)
  audience    String
  channel     CampaignChannel
  scheduledAt DateTime?
  message     String

  sentCount   Int?
  openedCount Int?
  orderCount  Int?
  revenue     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Audit jurnali — append-only, tahrirlanmaydi/o'chirilmaydi
// ---------------------------------------------------------------------------

enum AuditCategory {
  ORDER
  PAYMENT
  USER
  SETTING
  CATALOG
  SYSTEM
}

model AuditLog {
  id        Int           @id @default(autoincrement())
  // Foydalanuvchi o'chirilsa ham yozuv saqlanib qolishi uchun ataylab FK emas
  actorId   Int?
  actorName String
  actorRole String
  action    String
  category  AuditCategory
  context   String?
  ip        String?
  createdAt DateTime      @default(now())

  @@index([category])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Sozlamalar — umumiy kalit/qiymat ombori (masalan yetkazish slotlari)
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
