{
  "expo": {
    "name": "Formo",
    "slug": "formo",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070A24"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Formo yetkazish manzilini xaritada aniqlash uchun joylashuvingizdan foydalanadi.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.formo.app"
    },
    "android": {
      "package": "com.formo.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "updates": {
      "enabled": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
