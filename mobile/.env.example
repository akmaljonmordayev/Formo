# Backend manzili (docker compose up bilan 3001-portda ishlaydi).
# Telefonda "localhost" ishlamaydi — kompyuteringizning Wi-Fi IP manzilini yozing:
#   macOS:   ipconfig getifaddr en0
#   Windows: ipconfig  ->  "IPv4 Address"
# Telefon va kompyuter bitta Wi-Fi'da bo'lishi shart.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3001/api

# Android emulator:  EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api
# iOS simulator / Expo web:  EXPO_PUBLIC_API_URL=http://localhost:3001/api
