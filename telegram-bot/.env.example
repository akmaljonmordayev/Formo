# Formo Telegram bot — nusxa oling: cp .env.example .env  (.env commit qilinmaydi)

# @BotFather bergan token. Backend'dagi TELEGRAM_BOT_TOKEN (admin bildirishnomalari) bilan bir xil bot bo'lishi mumkin.
TELEGRAM_BOT_TOKEN=

# Backend API manzili (/api bilan). Railway'da ichki tarmoq: http://<backend>.railway.internal:3001/api
BACKEND_URL=http://localhost:3001/api

# Backend'dagi TELEGRAM_INTERNAL_TOKEN bilan aynan bir xil, kamida 32 belgi: openssl rand -hex 32
TELEGRAM_INTERNAL_TOKEN=

# polling — lokal ishlab chiqish (ochiq URL shart emas); webhook — production
BOT_MODE=polling

# Faqat BOT_MODE=webhook uchun. URL https bo'lishi shart; secret — A-Z a-z 0-9 _ -, kamida 32 belgi.
# Ishga tushganda bot setWebhook ni o'zi chaqiradi.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# HTTP server: GET /health va webhook
PORT=8080

# Xabarlar navbatini (buyurtma holati) tekshirish oralig'i, ms
OUTBOX_INTERVAL_MS=5000
