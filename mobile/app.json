{
  "expo": {
    "name": "Formo",
    "slug": "formo",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050818",
          "image": "./assets/formologo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Formo yetkazish manzilini xaritada aniqlash uchun joylashuvingizdan foydalanadi.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.formo.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tg"
        ]
      }
    },
    "android": {
      "package": "com.formo.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "updates": {
      "enabled": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
